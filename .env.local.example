# Supabase project URL (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon key (safe in browser; respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (server-only; bypasses RLS — only used in API routes that need to set app.* GUCs for family sessions)
SUPABASE_SERVICE_ROLE_KEY=

# Cookie signing secret for family portal session (any 32+ char random string)
FAMILY_SESSION_SECRET=

# Public site URL (used in WhatsApp share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
